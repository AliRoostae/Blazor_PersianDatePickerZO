@inherits BaseDatePickerRangeZO

<div class="picker-pack">
    <div class="picker-box-range darkred">
        @if (PopupDatePickerZO)
        {
            <div class="input-group-picker">
                <input type="text" value="@_dateFa" readonly />
                <button @onclick="ShowPicker">&#128197;</button>
            </div>
            if (_show)
            {
                <div class="frame-position-zo range-box">
                    <div class="title-range">@_dateFa</div>
                    <div class="frame-box">
                        <div class=" frame from @ThemePickerZO">
                            <div class="title">شروع : @_dateFaFirst</div>
                            <YearMonthZO SingelUs="false" SelectDate="@SelectDateFirst" MaxDate="@SelectDateLast" MinDate="@MinDate" ThemePickerZO="@ThemePickerZO" SelectDateChanged="OnSelectDateFirstChanged" />
                            <DayZO SingelUs="false" SelectDate="@SelectDateFirst" MaxDate="@SelectDateLast" MinDate="@MinDate" ThemePickerZO="@ThemePickerZO" SelectDateChanged="OnSelectDateFirstChanged" />
                            <TimeZO SingelUs="false" SelectDate="@SelectDateFirst" MaxDate="@SelectDateLast" MinDate="@MinDate" ThemePickerZO="@ThemePickerZO" SelectDateChanged="OnSelectDateFirstChanged" />
                        </div>
                        <div class="frame to @ThemePickerZO">
                            <div class="title">پایان : @_dateFaLast</div>
                            <YearMonthZO SingelUs="false" SelectDate="@SelectDateLast" MaxDate="@MaxDate" MinDate="@SelectDateFirst" ThemePickerZO="@ThemePickerZO" SelectDateChanged="OnSelectDateLastChanged"/>
                            <DayZO SingelUs="false" SelectDate="@SelectDateLast" MaxDate="@MaxDate" MinDate="@SelectDateFirst" ThemePickerZO="@ThemePickerZO"  SelectDateChanged="OnSelectDateLastChanged" />
                            <TimeZO SingelUs="false" SelectDate="@SelectDateLast" MaxDate="@MaxDate" MinDate="@SelectDateFirst" ThemePickerZO="@ThemePickerZO"  SelectDateChanged="OnSelectDateLastChanged"/>
                        </div>
                    </div>
                    <div class="range-btn-list">
                        <button class="close" @onclick="ColsePopup">تأیید</button>
                        <button @onclick="GetDayRange" class="select-today">یک روزه</button>
                        <button @onclick="GetWeekRange" class="select-today">یک هفته</button>
                        <button @onclick="GetMonthRange" class="select-today">یک ماه</button>
                        <button @onclick="GetYearRange" class="select-today">یک سال</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="range-box">
                <div class="title-range">@_dateFa</div>
                <div class="frame-box">
                    <div class="frame from @ThemePickerZO">
                        <div class="title">شروع : @_dateFaFirst</div>
                        <YearMonthZO SelectDate="@SelectDateFirst" MaxDate="@SelectDateLast" MinDate="@MinDate" ThemePickerZO="@ThemePickerZO" SelectDateChanged="OnSelectDateFirstChanged" />
                        <DayZO SelectDate="@SelectDateFirst" MaxDate="@SelectDateLast" MinDate="@MinDate" ThemePickerZO="@ThemePickerZO" SelectDateChanged="OnSelectDateFirstChanged" />
                        <TimeZO SelectDate="@SelectDateFirst" MaxDate="@SelectDateLast" MinDate="@MinDate" ThemePickerZO="@ThemePickerZO" SelectDateChanged="OnSelectDateFirstChanged" />
                    </div>
                    <div class="frame to @ThemePickerZO">
                        <div class="title">پایان : @_dateFaLast</div>
                        <YearMonthZO SelectDate="@SelectDateLast" MaxDate="@MaxDate" MinDate="@SelectDateFirst" ThemePickerZO="@ThemePickerZO" SelectDateChanged="OnSelectDateLastChanged" />
                        <DayZO SelectDate="@SelectDateLast" MaxDate="@MaxDate" MinDate="@SelectDateFirst" ThemePickerZO="@ThemePickerZO" SelectDateChanged="OnSelectDateLastChanged" />
                        <TimeZO SelectDate="@SelectDateLast" MaxDate="@MaxDate" MinDate="@SelectDateFirst" ThemePickerZO="@ThemePickerZO" SelectDateChanged="OnSelectDateLastChanged" />
                    </div>
                </div>
                <div class="range-btn-list">
                    <button class="close" @onclick="Change">تأیید</button>
                    <button @onclick="GetDayRange" class="select-today">یک روزه</button>
                    <button @onclick="GetWeekRange" class="select-today">یک هفته</button>
                    <button @onclick="GetMonthRange" class="select-today">یک ماه</button>
                    <button @onclick="GetYearRange" class="select-today">یک سال</button>
                </div>
            </div>
        }
    </div>
</div>

